<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CleanHome" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/default_wallpaper</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- See-through, so the Apple TV style can show these screens as glass over the home screen. -->
    <style name="Theme.CleanHome.Settings">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
